Screen {
    layout: vertical;
}

Screen > .screen--selection {
    background: $surface-lighten-2;
    color: $text;
}

Screen, #command-list, #command-info {
    scrollbar-size: 1 1;
}

#body {
    height: 1fr;
    padding: 1;
}

.panel-title {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#command-list {
    layout: horizontal;
    height: 1fr;
    margin-top: 1;
    width: 100%;
    overflow-x: auto;
    scrollbar-color: $text-muted;
    scrollbar-color-hover: $text;
    scrollbar-color-active: $text;
    scrollbar-background: $surface;
}

#command-summary {
    height: 4;
    padding: 0 1;
    border-top: solid $primary-darken-2;
    background: $surface-darken-1;
}

#command-summary-content {
    height: 2;
    padding-left: 1;
    border-left: heavy $panel;
}

.command-summary-row {
    height: 1;
}

.command-summary-label {
    width: 13;
    color: $text-muted;
    text-style: bold;
}

.command-prompt {
    width: 2;
    color: $text-muted;
}

#command-summary-description, #command-summary-command {
    width: 1fr;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.command-column {
    width: 28;
    min-width: 28;
    height: 100%;
}

.command-button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $text;
    content-align: left middle;
    text-align: left;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.command-button:hover, .command-button:focus {
    background: transparent;
    color: $text;
}

.command-button.is-selected {
    color: $primary;
}

.command-separator, .command-separator:disabled {
    color: $primary;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    opacity: 1;
}

#command-details {
    width: 1fr;
    height: 100%;
}

#command-info {
    width: 100%;
    height: 100%;
    padding: 1 2;
    border: round $primary;
    background: $surface;
    overflow-y: auto;
}

#command-info-title {
    color: $text;
    text-style: bold;
    text-wrap: wrap;
}

#command-info-description {
    color: $text;
    text-wrap: wrap;
}

#command-info-command {
    color: $text;
    text-wrap: wrap;
}

.info-label {
    margin-top: 1;
    color: $text-muted;
}

.help-hint {
    margin-top: 1;
    color: $text-muted;
}

.close-button {
    dock: bottom;
    width: auto;
    height: 1;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: $primary-darken-2;
    color: $text;
}

.close-button:hover, .close-button:focus {
    background: $primary;
}

#status-bar {
    height: 3;
    padding: 0 1;
    background: $surface-darken-1;
    border-bottom: solid $panel;
}

#status {
    width: 1fr;
    height: 2;
}

#status-spacer {
    height: 1;
}

#status-message {
    width: auto;
    color: $text;
}

#status-space {
    width: 1fr;
}

#status-time {
    width: auto;
    height: 1;
    color: $text;
    text-align: right;
}

#status-message.status-success {
    color: $success;
}

#status-message.status-error {
    color: $error;
}

#status-line {
    height: 1;
}
Footer {
    color: $text-muted;
    background: $surface-darken-1;
}

FooterKey {
    .footer-key--key {
        color: $primary;
    }
}
